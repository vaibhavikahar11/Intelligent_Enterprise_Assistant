# ─── LLM (Google Gemini) ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEN_MODEL=gemini-2.0-flash
VALIDATOR_MODEL=gemini-2.0-flash
EMBED_MODEL=text-embedding-004

# ─── Meta WhatsApp Cloud API ─────────────────────────────────────────
META_WHATSAPP_TOKEN=your_meta_whatsapp_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_VERIFY_TOKEN=your_custom_verify_token_here

# ─── Twilio WhatsApp (optional fallback) ────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Infrastructure ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8000
PORT=3000
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.io

# ─── Cache ──────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=86400
CACHE_SIM_THRESHOLD=0.92

# ─── Retrieval ──────────────────────────────────────────────────────
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.5

# ─── Pipeline ───────────────────────────────────────────────────────
VALIDATE_REQUESTS=true
